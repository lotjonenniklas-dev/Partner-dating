{
  "expo": {
    "name": "Partner",
    "slug": "partner",
    "scheme": "partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Partner lisää kuvat profiiliisi tästä puhelimesta.",
          "cameraPermission": "Partner voi ottaa profiilikuvan kameralla."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Partner käyttää sijaintia näyttääkseen sinulle lähellä olevat profiilit.",
          "locationAlwaysPermission": "Partner päivittää sijaintisi taustalla, jotta muut käyttäjät näkevät ajantasaisen sijaintisi.",
          "locationWhenInUsePermission": "Partner käyttää sijaintia näyttääkseen sinulle lähellä olevat profiilit.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ]
  }
}
